# Sam — environment reference. Copy to .env for local runs; .env is gitignored.
# Never commit real values: this repository is public.
# Full explanation of what each key unlocks is in CAPABILITIES.md.

# ─── Required ────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
# At least one channel:
TELEGRAM_TOKEN=
WA_ACCESS_TOKEN=
WA_PHONE_NUMBER_ID=
WA_VERIFY_TOKEN=
BEVERLY_WA_NUMBER=
# Proactive delivery outside Meta's 24-hour window. Register the template once
# via POST /admin/register-template (needs WA_WABA_ID), wait for Meta approval,
# then set WA_TEMPLATE_NAME. Rejected briefings queue in Postgres and are
# delivered the moment Beverly next messages Sam.
WA_WABA_ID=
WA_TEMPLATE_NAME=
WA_TEMPLATE_LANG=en

# ─── Durable memory (the important one) ──────────────────────────────────────
# On Railway: add a Postgres service, then set this on sam-telegram-bot as a
# reference — DATABASE_URL=${{Postgres.DATABASE_URL}}. Railway does NOT wire it
# across services automatically.
DATABASE_URL=
# "off" for *.railway.internal hosts (detected automatically; override if needed)
PGSSL=

# ─── Token routing (Hermes via OpenRouter) ───────────────────────────────────
# Absent = everything runs on Claude. Works, costs more.
OPENROUTER_API_KEY=
HERMES_MODEL=nousresearch/hermes-4-70b
HERMES_HEAVY_MODEL=nousresearch/hermes-4-405b

# ─── Market data ─────────────────────────────────────────────────────────────
# Free tier at https://finnhub.io — 60 calls/min.
FINNHUB_API_KEY=
BASE_CURRENCY=EUR

# ─── Trading 212 (optional, READ ONLY) ───────────────────────────────────────
# Sam has no order-placement path. This imports positions, nothing else.
T212_API_KEY=
T212_ENV=live

# ─── Existing integrations ───────────────────────────────────────────────────
ODOO_URL=
ODOO_DB=
ODOO_LOGIN=
ODOO_API_KEY=
FIREFISH_CLIENT_ID=
FIREFISH_CLIENT_SECRET=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_TENANT_ID=
BEVERLY_EMAIL=
BRAVE_API_KEY=
GROQ_API_KEY=
HEALTH_TOKEN=

# ─── Proactive cadence (optional overrides) ──────────────────────────────────
MORNING_HOUR_MALTA=7
WEEKLY_DEBRIEF_DAY=Fri
WEEKLY_DEBRIEF_HOUR=16
CHASE_HOUR=12
STALE_DAY=Mon
STALE_HOUR=9
MEETING_PREP_MINS=30
WATCHLIST_ALERTS=on

# ─── Gordon (cross-agent ops visibility, optional) ───────────────────────────
# Gordon watches all of TRC's bots from a Telegram ops group. Both optional —
# unset means Sam's alerts only go to ADMIN_TELEGRAM_CHAT_IDS, as before.
# GORDON_ALERT_SECRET must equal Gordon's own TELEGRAM_WEBHOOK_SECRET, copied
# by hand from the gordon Railway service (different Railway project — no
# ${{cross-project}} reference shortcut). Never guess or invent this value.
GORDON_INTERNAL_URL=
GORDON_ALERT_SECRET=
