# Sam — environment reference. Copy to .env for local runs; .env is gitignored.
# Never commit real values: this repository is public.
# Full explanation of what each key unlocks is in CAPABILITIES.md.

# ─── Required ────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
# At least one channel:
TELEGRAM_TOKEN=
WA_ACCESS_TOKEN=
WA_PHONE_NUMBER_ID=
WA_VERIFY_TOKEN=
BEVERLY_WA_NUMBER=
# Optional but recommended: Beverly's Telegram chat id. Fallback route when a
# proactive WhatsApp send is rejected by Meta's 24-hour window — without it a
# rejected briefing alerts the admin chat but reaches Beverly nowhere.
BEVERLY_TG_CHAT_ID=

# ─── Durable memory (the important one) ──────────────────────────────────────
# On Railway: add a Postgres service, then set this on sam-telegram-bot as a
# reference — DATABASE_URL=${{Postgres.DATABASE_URL}}. Railway does NOT wire it
# across services automatically.
DATABASE_URL=
# "off" for *.railway.internal hosts (detected automatically; override if needed)
PGSSL=

# ─── Token routing (Hermes via OpenRouter) ───────────────────────────────────
# Absent = everything runs on Claude. Works, costs more.
OPENROUTER_API_KEY=
HERMES_MODEL=nousresearch/hermes-4-70b
HERMES_HEAVY_MODEL=nousresearch/hermes-4-405b

# ─── Market data ─────────────────────────────────────────────────────────────
# Free tier at https://finnhub.io — 60 calls/min.
FINNHUB_API_KEY=
BASE_CURRENCY=EUR

# ─── Trading 212 (optional, READ ONLY) ───────────────────────────────────────
# Sam has no order-placement path. This imports positions, nothing else.
T212_API_KEY=
T212_ENV=live

# ─── Existing integrations ───────────────────────────────────────────────────
ODOO_URL=
ODOO_DB=
ODOO_LOGIN=
ODOO_API_KEY=
FIREFISH_CLIENT_ID=
FIREFISH_CLIENT_SECRET=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_TENANT_ID=
BEVERLY_EMAIL=
BRAVE_API_KEY=
GROQ_API_KEY=
HEALTH_TOKEN=

# ─── Proactive cadence (optional overrides) ──────────────────────────────────
MORNING_HOUR_MALTA=7
WEEKLY_DEBRIEF_DAY=Fri
WEEKLY_DEBRIEF_HOUR=16
CHASE_HOUR=12
STALE_DAY=Mon
STALE_HOUR=9
MEETING_PREP_MINS=30
WATCHLIST_ALERTS=on
